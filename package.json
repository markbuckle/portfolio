{
  "name": "portfolio2",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "framer-motion": "^10.16.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.383.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "react-router-dom": "^6.20.0",
    "react-router-hash-link": "^2.4.3",
    "react-scripts": "5.0.1",
    "three": "^0.185.1"
  },
  "scripts": {
    "start": "concurrently -k -n web,api -c cyan,magenta \"react-scripts start\" \"npm:dev:api\"",
    "dev:api": "wrangler pages dev public --port 8788 --compatibility-date=2026-05-03",
    "build": "react-scripts build",
    "preview": "npm run build && wrangler pages dev build --compatibility-date=2026-05-03"
  },
  "_comment_proxy": "CRA's dev server forwards anything it can't serve itself (i.e. /api/*) to Wrangler on 8788, so the app keeps hot reload while the Pages Function handles the form.",
  "proxy": "http://localhost:8788",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "wrangler": "^4.86.0"
  }
}
